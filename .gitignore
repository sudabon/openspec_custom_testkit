# MacOS
**/.DS_Store

# IDE
.vscode/
.specstory/
.serena/
.uv-cache/

# CodingAgent
.cursor/
# Ignore agent trees everywhere, then re-include the kit payload. A bare
# `.claude/` rule excludes the directory itself, so a later `!` cannot
# bring the files back.
**/.claude/**
!payload/.claude/
!payload/.claude/**
!upstream/baselines/**/.claude/
!upstream/baselines/**/.claude/**
.codex/
.agents/

# Cursor
.cursorrules
.cursorignore
.cursorindexingignore

# Dependencies and local output. User ignore rules above stay in place.
node_modules/
test-results/
*.tgz
.tmp/
