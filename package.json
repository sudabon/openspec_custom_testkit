{
  "name": "openspec-custom-testkit",
  "version": "0.1.0",
  "description": "Bootstrap kit for an integrated OpenSpec quality and E2E workflow. Distributes quality-driven-e2e and keeps legacy quality-driven and spec-driven-e2e changes runnable.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "openspec-custom-testkit": "./install.mjs"
  },
  "scripts": {
    "bundle:yaml": "node scripts/bundle-yaml.mjs",
    "manifest": "node scripts/build-manifest.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node --test test/*.test.mjs",
    "test:smoke": "node test/smoke.mjs",
    "prepack": "node scripts/bundle-yaml.mjs"
  },
  "files": [
    "install.mjs",
    "lib",
    "payload",
    "LICENSE",
    "README.md",
    "docs",
    "examples",
    "upstream/manifest.json",
    "upstream/baselines"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudabon/openspec_custom_testkit.git"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "esbuild": "0.25.10",
    "yaml": "2.8.1"
  }
}
